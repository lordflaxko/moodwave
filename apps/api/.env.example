# --- Core ---------------------------------------------------------------
ENVIRONMENT=development
FRONTEND_URL=http://127.0.0.1:3000
# DATABASE_URL defaults to apps/api/moodwave.db; any SQLAlchemy URL works (e.g. Postgres).
# DATABASE_URL=sqlite:///./moodwave.db
# Long random string. Signs session cookies and derives the token-encryption key.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# --- Spotify (optional: leave blank to run on the demo catalog) ----------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a Redirect URI in your Spotify app settings.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
SPOTIFY_MARKET=US

# --- Anthropic (optional: leave blank to use the offline heuristic curator) --------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_ENABLE_FALLBACKS=true
